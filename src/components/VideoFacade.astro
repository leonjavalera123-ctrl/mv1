---
// Click-to-load YouTube facade: renders only a thumbnail + play button.
// The iframe (youtube-nocookie.com) is injected by embeds.ts ONLY after
// the user clicks — never 200 iframes on page load, and no YouTube
// cookies/requests at all until a deliberate play. Thumbnails come from
// YouTube's own CDN, which is part of the sanctioned embed pattern.
interface Props {
  videoId: string;
  title: string;
}
const { videoId, title } = Astro.props;
---

<a
  class="facade"
  href={`https://www.youtube.com/watch?v=${videoId}`}
  rel="external noopener"
  data-facade
  data-video-id={videoId}
  data-video-title={title}
  aria-label={`Play video: ${title}`}
>
  <img
    src={`https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`}
    alt=""
    width="480"
    height="360"
    loading="lazy"
    decoding="async"
  />
  <span class="play" aria-hidden="true">
    <svg viewBox="0 0 68 48" width="68" height="48">
      <path class="shape" d="M66.5 7.7c-.8-2.9-3-5.2-5.9-6C55.4.3 34 .3 34 .3s-21.4 0-26.6 1.4c-2.9.8-5.1 3.1-5.9 6C.1 13 .1 24 .1 24s0 11 1.4 16.3c.8 2.9 3 5.2 5.9 6C12.6 47.7 34 47.7 34 47.7s21.4 0 26.6-1.4c2.9-.8 5.1-3.1 5.9-6C67.9 35 67.9 24 67.9 24s0-11-1.4-16.3z" />
      <path class="arrow" d="M45 24 27 14v20" />
    </svg>
  </span>
  <span class="label">{title}</span>
</a>

<style>
  .facade {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    padding: 0;
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    overflow: hidden;
    cursor: pointer;
    background: var(--c-bg-deep);
  }

  .facade img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
    transition: opacity 0.2s ease, transform 0.3s ease;
  }

  .facade:hover img,
  .facade:focus-visible img {
    opacity: 1;
    transform: scale(1.03);
  }

  @media (prefers-reduced-motion: reduce) {
    .facade img {
      transition: none;
    }
    .facade:hover img {
      transform: none;
    }
  }

  .play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }

  .play .shape {
    fill: rgba(10, 14, 39, 0.82);
    transition: fill 0.15s ease;
  }

  .facade:hover .play .shape,
  .facade:focus-visible .play .shape {
    fill: var(--c-red);
  }

  .play .arrow {
    fill: #fff;
  }

  .label {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.4rem 1rem 0.7rem;
    background: linear-gradient(transparent, rgba(6, 9, 25, 0.92));
    font-size: 0.85rem;
    font-weight: 600;
    text-align: left;
    color: var(--c-text);
  }
</style>
