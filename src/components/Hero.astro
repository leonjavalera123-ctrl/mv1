---
// Full-viewport intro: wordmark, tagline, career stat counters, scroll cue.
// The counters render their real values in static HTML (works with JS off);
// Phase 3 adds the count-up animation on top via the data-count attributes.
import Wordmark from './Wordmark.astro';
import driver from '../../data/driver.json';

const stats = [
  { label: 'World Championships', value: driver.career.championships },
  { label: 'Grand Prix Wins', value: driver.career.wins },
  { label: 'Podiums', value: driver.career.podiums },
  { label: 'Pole Positions', value: driver.career.poles },
];
---

<header class="hero" id="top">
  <!-- Original SVG speed-line art: pure decoration, hidden from AT -->
  <svg class="speedlines" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <linearGradient id="fade-red" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#d21f2c" stop-opacity="0" />
        <stop offset="1" stop-color="#d21f2c" stop-opacity="0.8" />
      </linearGradient>
      <linearGradient id="fade-orange" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#ff7900" stop-opacity="0" />
        <stop offset="1" stop-color="#ff7900" stop-opacity="0.9" />
      </linearGradient>
      <linearGradient id="fade-blue" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#3a4a9f" stop-opacity="0" />
        <stop offset="1" stop-color="#3a4a9f" stop-opacity="0.7" />
      </linearGradient>
      <radialGradient id="glow" cx="0.5" cy="0.42" r="0.6">
        <stop offset="0" stop-color="#1a2258" />
        <stop offset="1" stop-color="#0a0e27" />
      </radialGradient>
    </defs>
    <rect width="1440" height="900" fill="url(#glow)" />
    <g transform="skewY(-7)">
      <rect x="-100" y="180" width="620" height="5" fill="url(#fade-red)" />
      <rect x="120" y="215" width="900" height="2" fill="url(#fade-blue)" />
      <rect x="-60" y="300" width="480" height="3" fill="url(#fade-orange)" />
      <rect x="640" y="330" width="880" height="6" fill="url(#fade-red)" />
      <rect x="300" y="470" width="740" height="2" fill="url(#fade-blue)" />
      <rect x="820" y="560" width="700" height="4" fill="url(#fade-orange)" />
      <rect x="-80" y="640" width="560" height="2" fill="url(#fade-blue)" />
      <rect x="420" y="700" width="1100" height="5" fill="url(#fade-red)" />
      <rect x="60" y="820" width="800" height="3" fill="url(#fade-orange)" />
    </g>
  </svg>

  <div class="hero-inner container">
    <p class="kicker">2015 — Today · An unofficial fan tribute</p>
    <h1>
      <Wordmark size="hero" />
      <span class="sr-only">MV1 —</span>
      <span class="subtitle">The Max Verstappen Story</span>
    </h1>

    <dl class="stats">
      {stats.map((stat) => (
        <div class="stat">
          <dd data-count={stat.value}>{stat.value}</dd>
          <dt>{stat.label}</dt>
        </div>
      ))}
    </dl>
  </div>

  <a class="scroll-cue" href="#origin" aria-label="Scroll to the story">
    <span aria-hidden="true">▾</span>
  </a>
</header>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    overflow: hidden;
    text-align: center;
  }

  .speedlines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-inner {
    position: relative;
    padding-block: 5rem;
  }

  h1 {
    margin-block: 1rem 2.5rem;
  }

  .subtitle {
    display: block;
    margin-top: 1.2rem;
    font-size: clamp(1.1rem, 3.2vw, 1.9rem);
    letter-spacing: 0.32em;
    color: var(--c-text-dim);
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  .stat {
    min-width: 10.5rem;
    padding: 1.1rem 1.4rem;
    background: color-mix(in srgb, var(--c-surface) 72%, transparent);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    backdrop-filter: blur(4px);
  }

  .stat dd {
    font-family: var(--font-display);
    font-size: 2.6rem;
    line-height: 1;
    color: var(--c-orange);
  }

  .stat dt {
    margin-top: 0.35rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--c-text-dim);
  }

  .scroll-cue {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    translate: -50% 0;
    font-size: 1.6rem;
    color: var(--c-text-dim);
    text-decoration: none;
    animation: bob 1.8s ease-in-out infinite;
  }

  @keyframes bob {
    50% {
      transform: translateY(8px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-cue {
      animation: none;
    }
  }
</style>
