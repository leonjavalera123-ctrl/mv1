# MV1 environment template.
# Copy this file to `.env` and fill in real values. `.env` is gitignored —
# never commit real keys. In CI these values come from GitHub Actions secrets
# with the same names.

# YouTube Data API v3 key (Google Cloud console). Used ONLY by
# scripts/update_highlights.py to find official highlight video IDs.
# The website itself embeds videos without any key.
YOUTUBE_API_KEY=

# Optional: contact info sent in the User-Agent header of API requests
# (Wikimedia asks for this as a courtesy so they can reach you if a script
# misbehaves). An email or the repo URL is fine.
CONTACT_INFO=
